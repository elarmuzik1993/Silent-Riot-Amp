{"version":"2.0.0","tasks":[
  {"label":"Configure","type":"shell","command":"cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_EXPORT_COMPILE_COMMANDS=ON","group":"build"},
  {"label":"Build","type":"shell","command":"cmake --build build -j$(nproc)","group":{"kind":"build","isDefault":true},"problemMatcher":"$gcc"},
  {"label":"Test","type":"shell","command":"cmake -B build -DTT_BUILD_TESTS=ON && cmake --build build && cd build && ctest --output-on-failure","group":"test"},
  {"label":"Clean","type":"shell","command":"rm -rf build build-release"}
]}
